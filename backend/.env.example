# Application
NODE_ENV=development
PORT=8314

# MongoDB
MONGODB_URI=mongodb://localhost:8310/omnichat

# Kafka
KAFKA_BROKERS=localhost:8311
KAFKA_CLIENT_ID=omnichat-backend
KAFKAJS_NO_PARTITIONER_WARNING=1

# Redis
REDIS_HOST=localhost
REDIS_PORT=8313
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback

# Zalo
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/zalo/callback

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback

# Shopee
SHOPEE_ENV=test  # 'test' for test environment, 'production' (or omit) for production
SHOPEE_PARTNER_ID=1110319
SHOPEE_PARTNER_KEY=55715a655578554c6f716f6f5458636670586a554e544c6e6274496171555353
SHOPEE_REDIRECT_URI=http://localhost:3000/api/platform-connections/shopee/callback
SHOPEE_REGION=vn

# WebSocket
WS_PORT=8315
WS_CORS_ORIGIN=http://localhost:8315

# Frontend URL
FRONTEND_URL=http://localhost:8315

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=8314
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=omnichat-media
MINIO_PUBLIC_URL=http://localhost:8314/omnichat-media
