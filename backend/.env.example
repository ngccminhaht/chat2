# Application
NODE_ENV=development
PORT=8314

# MongoDB
MONGODB_URI=mongodb://localhost:8310/omnichat

# Kafka
KAFKA_BROKERS=localhost:8311
KAFKA_CLIENT_ID=omnichat-backend
KAFKAJS_NO_PARTITIONER_WARNING=1

# Redis
REDIS_HOST=localhost
REDIS_PORT=8313
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Facebook
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_REDIRECT_URI=http://localhost:3000/api/platform-connections/facebook/callback

# Zalo
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/platform-connections/zalo/callback

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/platform-connections/tiktok/callback

# WebSocket
WS_PORT=8315
WS_CORS_ORIGIN=http://localhost:8315

# Frontend URL
FRONTEND_URL=http://localhost:8315
