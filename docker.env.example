# Copy this file to .env at the repository root and replace every placeholder.
# Use URL-safe passwords (letters/numbers) unless you URL-encode special characters
# in MONGODB_URI. For an existing Mongo volume, use its existing root password.
MONGO_PASSWORD=replace_with_local_mongo_password
MONGODB_URI=mongodb://omnichat_admin:replace_with_local_mongo_password@mongodb:27017/omnichat?authSource=admin

REDIS_PASSWORD=replace_with_local_redis_password
MINIO_ROOT_USER=replace_with_local_minio_user
MINIO_ROOT_PASSWORD=replace_with_local_minio_password
S3_ACCESS_KEY_ID=replace_with_local_minio_user
S3_SECRET_ACCESS_KEY=replace_with_local_minio_password
S3_REGION=us-east-1
S3_BUCKET=omnichat
S3_PUBLIC_URL=http://localhost:8314/omnichat

# Keycloak must be running separately and reachable at both URLs.
KEYCLOAK_SERVER_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=replace_with_realm
KEYCLOAK_CLIENT_ID=replace_with_client_id
KEYCLOAK_CLIENT_SECRET=
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=replace_with_realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=replace_with_client_id

NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Facebook OAuth: create an app in Meta for Developers and configure this exact redirect URI there.
FACEBOOK_APP_ID=replace_with_meta_app_id
FACEBOOK_APP_SECRET=replace_with_meta_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback
FACEBOOK_VERIFY_TOKEN=replace_with_random_verify_token
